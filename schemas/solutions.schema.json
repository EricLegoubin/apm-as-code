{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solutions.schema.json",
  "title": "Solutions externes",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "solutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sol-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "vendor": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "saas",
              "software",
              "middleware",
              "library",
              "infrastructure",
              "service"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ]
      }
    }
  },
  "required": [
    "solutions"
  ]
}
