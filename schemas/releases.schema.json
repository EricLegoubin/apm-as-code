{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "releases.schema.json",
  "title": "Séquences de versions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^cmp-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "description": "Version PEP 440 : 3.2.0, 2026.10, 1.0.0rc1"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "component": {
                    "type": "string",
                    "pattern": "^cmp-[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Contrainte PEP 440 : >=1.4, >=1.4,<2, ~=3.2 ; une version nue vaut =="
                  }
                },
                "required": [
                  "component",
                  "version"
                ]
              }
            }
          },
          "required": [
            "version"
          ]
        },
        "minItems": 1
      }
    },
    "application": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Version PEP 440 : 3.2.0, 2026.10, 1.0.0rc1"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^cmp-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "description": "Version PEP 440 : 3.2.0, 2026.10, 1.0.0rc1"
            },
            "minProperties": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "application": {
                  "type": "string",
                  "pattern": "^app-[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Contrainte PEP 440 : >=1.4, >=1.4,<2, ~=3.2 ; une version nue vaut =="
                }
              },
              "required": [
                "application",
                "version"
              ]
            }
          }
        },
        "required": [
          "version",
          "components"
        ]
      }
    }
  },
  "required": []
}
