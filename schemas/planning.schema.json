{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planning.schema.json",
  "title": "Planning de mise à disposition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Version PEP 440 : 3.2.0, 2026.10, 1.0.0rc1"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "status": {
            "enum": [
              "planned",
              "confirmed",
              "delivered",
              "cancelled"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "version",
          "date",
          "status"
        ]
      }
    }
  },
  "required": [
    "releases"
  ]
}
